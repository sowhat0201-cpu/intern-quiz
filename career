      2: '🌤️ <strong>剛剛好的警覺心：</strong> 2 分的微緊張能幫助你保持思考清晰，我們一起透過價值觀幫你把方向看得更透徹。',
      3: '💡 <strong>大腦正在保護你：</strong> 3 分的迷惘非常正常！就像走進有 500 道菜的自助餐，選擇變多反而讓人猶豫。接下來我們用遊戲幫你篩選出真正重要的菜色。',
      4: '🫂 <strong>抱抱正在努力的你：</strong> 4 分的焦慮代表你很想把未來走好。別擔心，今天我們不急著做「一輩子的決定」，只要找出「下一步」就好。',
      5: '🫶 <strong>深呼吸，你不是一個人：</strong> 5 分的壓力一定讓你很累吧？把腦中混亂的聲音交給這張羅盤，我們一步一步拆解，把大怪獸變成小任務。'
    };

    function setAnxiety(score) {
      state.anxietyScore = score;
      const buttons = document.querySelectorAll('.anxiety-btn');
      buttons.forEach(btn => {
        const s = Number(btn.dataset.score);
        if (s === score) {
          btn.className = 'anxiety-btn flex flex-col items-center p-3 rounded-2xl border-2 border-terracotta bg-terracottaLight transition transform scale-105';
        } else {
          btn.className = 'anxiety-btn flex flex-col items-center p-3 rounded-2xl border-2 border-stone-200 bg-cream/60 hover:border-terracotta/50 transition';
        }
      });
      document.getElementById('anxiety-feedback').innerHTML = ANXIETY_TEXTS[score];
    }

    // ==================== Step 1: 《價值觀拍賣會》三階段淘汰邏輯 ====================
    function renderAuctionStage() {
      const stage = state.auctionStage;
      const grid = document.getElementById('cards-grid');
      const badge = document.getElementById('auction-badge');
      const title = document.getElementById('auction-title');
      const desc = document.getElementById('auction-desc');
      const counter = document.getElementById('auction-counter');
      const legend = document.getElementById('category-legend');
      const rankHint = document.getElementById('stage3-rank-hint');
      const nextBtn = document.getElementById('btn-auction-next');

      let pool = [];
      let selectedList = [];
      let targetCount = 8;

      if (stage === 1) {
        pool = CORE_VALUES;
        selectedList = state.stage1Selected;
        targetCount = 8;
        badge.textContent = '第一輪：海選階段 (16 選 8)';
        badge.className = 'px-3 py-1 rounded-full bg-terracottaLight text-terracotta text-xs font-bold';
        title.textContent = '選出你有感覺的 8 個價值觀';
        desc.innerHTML = '這 16 張牌沒有好壞之分。請直覺點擊：<strong>「如果沒有這個東西，我的人生會覺得很空虛」</strong>的 8 張牌。';
        legend.classList.remove('hidden');
        rankHint.classList.add('hidden');
      } else if (stage === 2) {
        pool = CORE_VALUES.filter(v => state.stage1Selected.includes(v.id));
        selectedList = state.stage2Selected;
        targetCount = 5;
        badge.textContent = '第二輪：忍痛割愛 (8 選 5)';
        badge.className = 'px-3 py-1 rounded-full bg-ochreLight text-ochre text-xs font-bold';
        title.textContent = '人生資源有限，請忍痛淘汰 3 張';
        desc.innerHTML = '想像你的人生遇到關卡，必須割捨部分條件。請從這 8 張中，留下<strong>更不能妥協的 5 張</strong>。';
        legend.classList.add('hidden');
        rankHint.classList.add('hidden');
      } else if (stage === 3) {
        pool = CORE_VALUES.filter(v => state.stage2Selected.includes(v.id));
        selectedList = state.stage3Selected;
        targetCount = 3;
        badge.textContent = '最終決戰：核心底線 (5 選 3)';
        badge.className = 'px-3 py-1 rounded-full bg-sageLight text-sage text-xs font-bold';
        title.textContent = '留下你靈魂深處最核心的 3 張牌';
        desc.innerHTML = '最後一步！如果沒有這 3 個價值觀，你會覺得活得不像自己。<strong>依序點擊排出 TOP 1 ~ TOP 3</strong>。';
        legend.classList.add('hidden');
        rankHint.classList.remove('hidden');
      }

      // 更新計數器
      counter.innerHTML = `已選 <span class="text-terracotta text-base">${selectedList.length}</span> / ${targetCount} 張`;

      // 更新下一步按鈕狀態
      if (selectedList.length === targetCount) {
        nextBtn.disabled = false;
        nextBtn.className = 'flex-1 py-3.5 rounded-2xl bg-terracotta hover:bg-terracotta/90 text-white font-bold text-sm shadow-md shadow-terracotta/20 transition flex items-center justify-center gap-2 cursor-pointer';
        nextBtn.innerHTML = stage < 3
          ? `<span>進入下一輪淘汰</span><span>→</span>`
          : `<span>確認 TOP 3，進入羅盤校準</span><span>→</span>`;
      } else {
        nextBtn.disabled = true;
        nextBtn.className = 'flex-1 py-3.5 rounded-2xl bg-stone-200 text-stone-500 font-bold text-sm transition flex items-center justify-center gap-2 cursor-not-allowed';
        nextBtn.innerHTML = `<span>還需選擇 ${targetCount - selectedList.length} 張</span>`;
      }

      // 渲染卡片
      grid.innerHTML = pool.map(item => {
        const isSelected = selectedList.includes(item.id);
        const rankIndex = stage === 3 ? selectedList.indexOf(item.id) : -1;
        const style = COLOR_STYLES[item.color];

        // 在第2、3輪，未選中的卡片呈現「被割捨/淡化」視覺對比
        const cardStateClass = isSelected
          ? `border-2 ${style.ring} shadow-sm`
          : (stage > 1 ? 'border border-stone-200/80 bg-white/60 opacity-75 hover:opacity-100' : 'border border-stone-200 bg-paper hover:border-stone-300');

        return `
          <div onclick="toggleValueCard(${item.id})"
            class="value-card cursor-pointer rounded-2xl p-4 select-none relative ${cardStateClass}">
            <div class="flex items-start justify-between gap-2 mb-1.5">
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-bold px-2 py-0.5 rounded-md ${style.badge}">${item.cat}</span>
                <h4 class="font-bold text-base text-ink">${item.id}. ${item.title}</h4>
              </div>
              ${isSelected
                ? (stage === 3
                    ? `<span class="px-2.5 py-0.5 rounded-full bg-sage text-white text-xs font-bold shadow-sm">TOP ${rankIndex + 1}</span>`
                    : `<span class="w-6 h-6 rounded-full bg-terracotta text-white flex items-center justify-center text-xs font-bold shadow-sm">✓</span>`)
                : `<span class="w-6 h-6 rounded-full border-2 border-stone-300 flex items-center justify-center text-xs text-transparent">✓</span>`
              }
            </div>
            <p class="text-xs text-muted leading-relaxed">${item.desc}</p>
          </div>
        `;
      }).join('');
    }

    function toggleValueCard(id) {
      const stage = state.auctionStage;
      let listKey = stage === 1 ? 'stage1Selected' : (stage === 2 ? 'stage2Selected' : 'stage3Selected');
      let maxCount = stage === 1 ? 8 : (stage === 2 ? 5 : 3);
      let currentList = state[listKey];

      if (currentList.includes(id)) {
        state[listKey] = currentList.filter(item => item !== id);
      } else {
        if (currentList.length >= maxCount) {
          showToast(`本輪最多只能保留 ${maxCount} 張牌！請先取消一張再選。`);
          return;
        }
        state[listKey] = [...currentList, id];
      }
      renderAuctionStage();
    }

    function handleAuctionNext() {
      const stage = state.auctionStage;
      if (stage === 1 && state.stage1Selected.length === 8) {
        // 清理 stage2 不在 stage1 內的舊紀錄
        state.stage2Selected = state.stage2Selected.filter(id => state.stage1Selected.includes(id));
        state.auctionStage = 2;
        renderAuctionStage();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else if (stage === 2 && state.stage2Selected.length === 5) {
        state.stage3Selected = state.stage3Selected.filter(id => state.stage2Selected.includes(id));
        state.auctionStage = 3;
        renderAuctionStage();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else if (stage === 3 && state.stage3Selected.length === 3) {
        goToStep(2);
      }
    }

    function handleAuctionBack() {
      if (state.auctionStage > 1) {
        state.auctionStage -= 1;
        renderAuctionStage();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        goToStep(0);
      }
    }

    // ==================== Step 2: 定義與內心誠實度 ====================
    function renderStep2Definitions() {
      const container = document.getElementById('top3-definitions-container');
      const top3Items = state.stage3Selected.map(id => CORE_VALUES.find(v => v.id === id));

      container.innerHTML = top3Items.map((item, idx) => {
        const savedVal = state.definitions[item.id] || '';
        const style = COLOR_STYLES[item.color];
        return `
          <div class="bg-paper rounded-3xl p-5 shadow-sm border border-stone-200/80 space-y-2.5">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full bg-sage text-white text-xs font-bold">TOP ${idx + 1}</span>
                <h3 class="font-bold text-lg text-ink">${item.title}</h3>
              </div>
              <span class="text-[11px] px-2 py-0.5 rounded-md ${style.badge}">${item.cat}</span>
            </div>
            <p class="text-xs text-muted">${item.desc}</p>
            <div class="pt-1">
              <label class="block text-xs font-bold text-ink mb-1">
                ✍️ 用一句話定義它對你的意義（沒有它，我會覺得……）：
              </label>
              <input type="text"
                value="${savedVal.replace(/"/g, '&quot;')}"
                oninput="state.definitions[${item.id}] = this.value"
                placeholder="例：對我來說，這代表我可以自己掌握節奏，不會像機器人一樣..."
                class="w-full px-3.5 py-2.5 rounded-xl bg-cream border border-stone-200 text-sm focus:outline-none focus:border-sage transition" />
            </div>
          </div>
        `;
      }).join('');
    }

    function updateHonestySlider(val) {
      const selfPct = Number(val);
      const otherPct = 100 - selfPct;
      state.selfPct = selfPct;

      document.getElementById('self-pct-label').textContent = selfPct;
      document.getElementById('other-pct-label').textContent = otherPct;

      const feedbackBox = document.getElementById('honesty-feedback');
      if (otherPct > 50) {
        feedbackBox.className = 'p-3.5 rounded-2xl bg-ochreLight border border-ochre/40 text-ink text-xs sm:text-sm leading-relaxed';
        feedbackBox.innerHTML = `🤔 <strong>溫柔提醒（別人期待佔 ${otherPct}%）：</strong> 你的價值觀似乎背負了不少爸媽或社會的眼光。試著問自己：「如果沒有人會評價我，我還是一樣選這 3 個嗎？」（如果需要調整，可以按左下角重選卡片喔！）`;
      } else {
        feedbackBox.className = 'p-3.5 rounded-2xl bg-sageLight text-sage text-xs sm:text-sm leading-relaxed';
        feedbackBox.innerHTML = `✨ <strong>很棒的內在覺察（自己想要佔 ${selfPct}%）：</strong> 你很清楚自己內心真正的渴望，這三個價值觀將會是你做決定時最強大的指南針！`;
      }
    }

    // ==================== Step 3: 十字路口 A/B 選擇星級評分 ====================
    function applyRoutePreset(nameA, nameB) {
      document.getElementById('option-a-name').value = nameA;
      document.getElementById('option-b-name').value = nameB;
      syncOptionNames();
      showToast('已套用參考選擇名稱，你也可以自由修改！');
    }

    function syncOptionNames() {
      const nameA = document.getElementById('option-a-name').value.trim() || '選擇 A';
      const nameB = document.getElementById('option-b-name').value.trim() || '選擇 B';
      document.querySelectorAll('.label-opt-a').forEach(el => el.textContent = nameA);
      document.querySelectorAll('.label-opt-b').forEach(el => el.textContent = nameB);
    }

    function renderStep3StarRatings() {
      const container = document.getElementById('star-rating-rows');
      const top3Items = state.stage3Selected.map(id => CORE_VALUES.find(v => v.id === id));

      container.innerHTML = top3Items.map((item, idx) => {
        const scoreA = state.ratingsA[item.id] || 0;
        const scoreB = state.ratingsB[item.id] || 0;

        return `
          <div class="p-4 rounded-2xl bg-cream/80 border border-stone-200 space-y-3">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded-md bg-sage text-white text-[11px] font-bold">TOP ${idx + 1}</span>
              <span class="font-bold text-sm text-ink">符合「${item.title}」的程度</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <!-- 選擇 A 星星 -->
              <div class="flex items-center justify-between bg-white px-3 py-2 rounded-xl border border-terracotta/20">
                <span class="text-xs font-bold text-terracotta truncate max-w-[110px] label-opt-a">${document.getElementById('option-a-name').value.trim() || '路線 A'}</span>
                <div class="flex gap-1">
                  ${[1, 2, 3, 4, 5].map(star => `
                    <button type="button" onclick="setStarRating('A', ${item.id}, ${star})"
                      class="text-xl leading-none transition transform active:scale-125 ${star <= scoreA ? 'text-amber-400' : 'text-stone-300'}">
                      ★
                    </button>
                  `).join('')}
                </div>
              </div>

              <!-- 選擇 B 星星 -->
              <div class="flex items-center justify-between bg-white px-3 py-2 rounded-xl border border-slateBlue/20">
                <span class="text-xs font-bold text-slateBlue truncate max-w-[110px] label-opt-b">${document.getElementById('option-b-name').value.trim() || '路線 B'}</span>
                <div class="flex gap-1">
                  ${[1, 2, 3, 4, 5].map(star => `
                    <button type="button" onclick="setStarRating('B', ${item.id}, ${star})"
                      class="text-xl leading-none transition transform active:scale-125 ${star <= scoreB ? 'text-amber-400' : 'text-stone-300'}">
                      ★
                    </button>
                  `).join('')}
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');

      updateTotalStars();
    }

    function setStarRating(route, valueId, stars) {
      if (route === 'A') {
        state.ratingsA[valueId] = stars;
      } else {
        state.ratingsB[valueId] = stars;
      }
      renderStep3StarRatings();
    }

    function updateTotalStars() {
      let totalA = 0;
      let totalB = 0;
      state.stage3Selected.forEach(id => {
        totalA += (state.ratingsA[id] || 0);
        totalB += (state.ratingsB[id] || 0);
      });
      document.getElementById('score-a-total').textContent = totalA;
      document.getElementById('score-b-total').textContent = totalB;
    }

    // ==================== Step 4: 恐懼回顧提示 ====================
    function updateFearRecap() {
      const fearA = document.getElementById('opt-a-fear').value.trim();
      const fearB = document.getElementById('opt-b-fear').value.trim();
      const nameA = document.getElementById('option-a-name').value.trim() || '選擇 A';
      const nameB = document.getElementById('option-b-name').value.trim() || '選擇 B';

      const recapEl = document.getElementById('recap-fear-text');
      if (!fearA && !fearB) {
        recapEl.textContent = '（你剛剛沒有填寫具體恐懼，可以直接在下方思考目前最讓你猶豫的擔憂！）';
      } else {
        let lines = [];
        if (fearA) lines.push(`• 【${nameA}】害怕：${fearA}`);
        if (fearB) lines.push(`• 【${nameB}】害怕：${fearB}`);
        recapEl.innerHTML = lines.join('<br>');
      }
    }

    // ==================== Step 5: 生成總結圖卡與匯出 ====================
    function generateSummaryCard() {
      // 1. 學生基本資料與情緒
      const cls = document.getElementById('input-class').value.trim() || '班級未填';
      const seat = document.getElementById('input-seat').value.trim() || '-';
      const name = document.getElementById('input-name').value.trim() || '探索者';
      document.getElementById('card-student-info').textContent = `${cls} · ${seat} 號 · ${name}`;

      const emojiMap = { 1: '😌', 2: '🙂', 3: '🤔', 4: '😰', 5: '🤯' };
      document.getElementById('card-anxiety-badge').textContent = `${state.anxietyScore} / 5 分 ${emojiMap[state.anxietyScore]}`;

      // 2. Top 3 核心價值觀與內心比例
      document.getElementById('card-honesty-tag').textContent = `內在渴望 ${state.selfPct}% · 外在期待 ${100 - state.selfPct}%`;
      const top3ListEl = document.getElementById('card-top3-list');
      const top3Items = state.stage3Selected.map(id => CORE_VALUES.find(v => v.id === id));

      top3ListEl.innerHTML = top3Items.map((item, idx) => {
        const def = (state.definitions[item.id] || '').trim() || item.desc;
        return `
          <div class="bg-white/95 rounded-2xl p-3 border border-stone-200/90 flex items-start gap-2.5">
            <span class="px-2 py-0.5 rounded-lg bg-sage text-white text-xs font-bold shrink-0 mt-0.5">TOP ${idx + 1}</span>
            <div>
              <p class="font-bold text-sm text-ink">${item.title}</p>
              <p class="text-xs text-muted mt-0.5 leading-snug">${def}</p>
            </div>
          </div>
        `;
      }).join('');

      // 3. A vs B 選擇對照
      const nameA = document.getElementById('option-a-name').value.trim() || '選擇 A（請自己命名）';
      const nameB = document.getElementById('option-b-name').value.trim() || '選擇 B（請自己命名）';
      let totalA = 0, totalB = 0;
      state.stage3Selected.forEach(id => {
        totalA += (state.ratingsA[id] || 0);
        totalB += (state.ratingsB[id] || 0);
      });

      document.getElementById('card-name-a').textContent = nameA;
      document.getElementById('card-name-b').textContent = nameB;
      document.getElementById('card-score-a').textContent = `${totalA} / 15 ★`;
      document.getElementById('card-score-b').textContent = `${totalB} / 15 ★`;

      const prosA = document.getElementById('opt-a-pros').value.trim() || '思考中...';
      const prosB = document.getElementById('opt-b-pros').value.trim() || '思考中...';
      document.getElementById('card-pros-a').textContent = `✨ ${prosA}`;
      document.getElementById('card-pros-b').textContent = `✨ ${prosB}`;

      // 4. Plan B 與 7 天微行動
      const planB = document.getElementById('fear-planb').value.trim() || '遇到困難時，我會尋求師長與夥伴的討論支持，隨時調整步伐。';
      const mvpDate = document.getElementById('mvp-date').value || '未來 7 天內';
      const mvpAction = document.getElementById('mvp-action').value.trim() || '主動蒐集一個相關資訊並與人討論';

      document.getElementById('card-planb').textContent = planB;
      document.getElementById('card-mvp-date').textContent = `${mvpDate} 前`;
      document.getElementById('card-mvp-action').textContent = mvpAction;

      // 時間戳記
      const today = new Date();
      document.getElementById('card-timestamp').textContent = `${today.getFullYear()}/${today.getMonth() + 1}/${today.getDate()}`;

      goToStep(5);
    }

    // 下載 PNG 圖卡
    async function downloadCardPNG() {
      const cardEl = document.getElementById('export-card');
      showToast('正在產生高畫質圖卡，請稍候...');
      try {
        const canvas = await html2canvas(cardEl, {
          scale: 2,
          backgroundColor: '#FAF7F2',
          useCORS: true
        });
        const link = document.createElement('a');
        const name = document.getElementById('input-name').value.trim() || '我的';
        link.download = `${name}_生涯決策羅盤.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();
        showToast('🎉 圖卡下載成功！可上傳至 Classroom 囉');
      } catch (err) {
        console.error(err);
        showToast('匯出發生小狀況，建議直接使用手機螢幕截圖保存！');
      }
    }

    // 複製純文字紀錄（使用 execCommand 相容 iFrame）
    function copyTextSummary() {
      const cls = document.getElementById('input-class').value.trim() || '未填班級';
      const seat = document.getElementById('input-seat').value.trim() || '-';
      const name = document.getElementById('input-name').value.trim() || '探索者';
      const top3Items = state.stage3Selected.map(id => CORE_VALUES.find(v => v.id === id));

      let totalA = 0, totalB = 0;
      state.stage3Selected.forEach(id => {
        totalA += (state.ratingsA[id] || 0);
        totalB += (state.ratingsB[id] || 0);
      });

      const nameA = document.getElementById('option-a-name').value.trim() || '選擇 A';
      const nameB = document.getElementById('option-b-name').value.trim() || '選擇 B';
      const planB = document.getElementById('fear-planb').value.trim() || '無';
      const mvpDate = document.getElementById('mvp-date').value || '7天內';
      const mvpAction = document.getElementById('mvp-action').value.trim() || '無';
      const peerNote = document.getElementById('peer-feedback-input').value.trim() || '無';

      const text = [
        `🧭 【我的生涯決策羅盤】`,
        `學生：${cls} ${seat}號 ${name}（課前焦慮指數：${state.anxietyScore}/5）`,
        ``,
        `一、我的三大核心價值觀（內在渴望 ${state.selfPct}% / 別人期待 ${100 - state.selfPct}%）`,
        ...top3Items.map((item, i) => `TOP ${i + 1}【${item.title}】：${state.definitions[item.id] || item.desc}`),
        ``,
        `二、十字路口模擬`,
        `• 選擇 A（${nameA}）：契合度 ${totalA}/15 ★`,
        `• 選擇 B（${nameB}）：契合度 ${totalB}/15 ★`,
        ``,
        `三、安全網與微行動`,
        `• 我的 Plan B：${planB}`,
        `• ${mvpDate} 前微行動承諾：${mvpAction}`,
        ``,
        `四、《人生顧問診所》夥伴回饋：${peerNote}`
      ].join('\n');

      const tempArea = document.createElement('textarea');
      tempArea.value = text;
      document.body.appendChild(tempArea);
      tempArea.select();
      document.execCommand('copy');
      document.body.removeChild(tempArea);

