<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>價值觀拍賣會 × 我的生涯決策羅盤</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Noto Sans TC & Noto Serif TC -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;700&display=swap" rel="stylesheet">
  <!-- html2canvas for exporting result card as PNG -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Noto Sans TC"', 'sans-serif'],
            serif: ['"Noto Serif TC"', 'serif'],
          },
          colors: {
            cream: '#FAF7F2',
            paper: '#FFFFFF',
            ink: '#2D2A26',
            muted: '#6E685F',
            terracotta: '#D96B43',
            terracottaLight: '#FBECE6',
            sage: '#4A7C59',
            sageLight: '#E8F2EC',
            ochre: '#D49A35',
            ochreLight: '#FDF5E6',
            slateBlue: '#4B6B88',
            slateBlueLight: '#EBF1F6',
            plum: '#7D5A78',
            plumLight: '#F4EEF3',
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #FAF7F2;
      color: #2D2A26;
      -webkit-tap-highlight-color: transparent;
      overflow-x: hidden;
    }

    /* 卡片平滑過渡動畫 */
    .value-card {
      transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .value-card:active {
      transform: scale(0.97);
    }

    /* 漸進顯示動畫 */
    @keyframes fadeSlideUp {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .step-animate {
      animation: fadeSlideUp 0.4s ease-out forwards;
    }

    /* 自訂滑桿樣式 */
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      height: 10px;
      border-radius: 999px;
      background: #E6DFD5;
      outline: none;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: #D96B43;
      border: 3px solid #FFFFFF;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
      cursor: pointer;
    }

    /* 手帳點點底紋 */
    .dot-grid {
      background-image: radial-gradient(#DCD5C9 1px, transparent 1px);
      background-size: 16px 16px;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col font-sans selection:bg-terracottaLight selection:text-terracotta">

  <!-- 頂部導覽列與進度條 -->
  <header class="sticky top-0 z-40 bg-cream/95 backdrop-blur-md border-b border-stone-200/80 px-4 py-3">
    <div class="max-w-2xl mx-auto flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="text-xl">🧭</span>
        <div>
          <h1 class="text-sm sm:text-base font-bold tracking-tight text-ink leading-tight">生涯決策羅盤</h1>
          <p id="step-subtitle" class="text-[11px] text-muted">Step 0 / 5 · 暖身與情緒溫度計</p>
        </div>
      </div>
    </div>

    <!-- 進度條 -->
    <div class="max-w-2xl mx-auto mt-2.5 bg-stone-200 h-1.5 rounded-full overflow-hidden">
      <div id="progress-bar" class="bg-terracotta h-full transition-all duration-500 rounded-full" style="width: 10%;"></div>
    </div>
  </header>

  <!-- 全域輕提示 (Toast) -->
  <div id="toast" class="fixed bottom-20 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 transition-all duration-300 transform translate-y-2">
    <div id="toast-msg" class="bg-ink text-white text-sm px-4 py-2.5 rounded-full shadow-lg flex items-center gap-2 whitespace-nowrap">
      提醒訊息
    </div>
  </div>

  <!-- 主內容區塊 -->
  <main class="flex-1 max-w-2xl w-full mx-auto px-4 pt-5 pb-28">

    <!-- ==================== STEP 0: 暖身與情緒溫度計 ==================== -->
    <section id="step-0" class="step-animate space-y-5">
      <div class="bg-paper rounded-3xl p-6 shadow-sm border border-stone-200/70">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-terracottaLight text-terracotta text-xs font-bold mb-3">
          <span>SEL 社會情緒學習</span> · <span>探索起點</span>
        </div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink leading-snug mb-2">
          在不確定中，<br>尋找屬於你的羅盤
        </h2>
        <p class="text-sm text-muted leading-relaxed">
          面對升學、實習或未來出路感到迷惘，並不是因為你不夠好，而是因為你對自己的人生很在乎。這份數位學習單不評分，請誠實傾聽內心的聲音。
        </p>
      </div>

      <!-- 基本資料 -->
      <div class="bg-paper rounded-3xl p-5 sm:p-6 shadow-sm border border-stone-200/70 space-y-4">
        <h3 class="font-bold text-base flex items-center gap-2 text-ink">
          <span class="w-6 h-6 rounded-full bg-stone-100 flex items-center justify-center text-xs">1</span>
          <span>建立你的探索檔案</span>
        </h3>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-medium text-muted mb-1">班級</label>
            <input type="text" id="input-class" placeholder="例：返一/返二"
              class="w-full px-3 py-2.5 rounded-xl bg-cream border border-stone-200 text-sm focus:outline-none focus:border-terracotta transition" />
          </div>
          <div>
            <label class="block text-xs font-medium text-muted mb-1">學號</label>
            <input type="text" id="input-seat" placeholder="例：11318000全碼"
              class="w-full px-3 py-2.5 rounded-xl bg-cream border border-stone-200 text-sm focus:outline-none focus:border-terracotta transition" />
          </div>
          <div>
            <label class="block text-xs font-medium text-muted mb-1">姓名 </label>
            <input type="text" id="input-name" placeholder="請輸入你的名字"
              class="w-full px-3 py-2.5 rounded-xl bg-cream border border-stone-200 text-sm focus:outline-none focus:border-terracotta transition" />
          </div>
        </div>
      </div>

      <!-- 情緒溫度計 -->
      <div class="bg-paper rounded-3xl p-5 sm:p-6 shadow-sm border border-stone-200/70 space-y-4">
        <h3 class="font-bold text-base flex items-center gap-2 text-ink">
          <span class="w-6 h-6 rounded-full bg-stone-100 flex items-center justify-center text-xs">2</span>
          <span>情緒溫度計：現在想到「未來選擇」，你的焦慮程度是？</span>
        </h3>

        <div class="grid grid-cols-5 gap-2 pt-1" id="anxiety-buttons">
          <button type="button" onclick="setAnxiety(1)" data-score="1"
            class="anxiety-btn flex flex-col items-center p-3 rounded-2xl border-2 border-stone-200 bg-cream/60 hover:border-terracotta/50 transition">
            <span class="text-2xl mb-1">😌</span>
            <span class="text-xs font-bold">1 分</span>
            <span class="text-[10px] text-muted">很平靜</span>
          </button>
          <button type="button" onclick="setAnxiety(2)" data-score="2"
            class="anxiety-btn flex flex-col items-center p-3 rounded-2xl border-2 border-stone-200 bg-cream/60 hover:border-terracotta/50 transition">
            <span class="text-2xl mb-1">🙂</span>
            <span class="text-xs font-bold">2 分</span>
            <span class="text-[10px] text-muted">微緊張</span>
          </button>
          <button type="button" onclick="setAnxiety(3)" data-score="3"
            class="anxiety-btn flex flex-col items-center p-3 rounded-2xl border-2 border-terracotta bg-terracottaLight transition">
            <span class="text-2xl mb-1">🤔</span>
            <span class="text-xs font-bold text-terracotta">3 分</span>
            <span class="text-[10px] text-terracotta">有點迷惘</span>
          </button>
          <button type="button" onclick="setAnxiety(4)" data-score="4"
            class="anxiety-btn flex flex-col items-center p-3 rounded-2xl border-2 border-stone-200 bg-cream/60 hover:border-terracotta/50 transition">
            <span class="text-2xl mb-1">😰</span>
            <span class="text-xs font-bold">4 分</span>
            <span class="text-[10px] text-muted">很焦慮</span>
          </button>
          <button type="button" onclick="setAnxiety(5)" data-score="5"
            class="anxiety-btn flex flex-col items-center p-3 rounded-2xl border-2 border-stone-200 bg-cream/60 hover:border-terracotta/50 transition">
            <span class="text-2xl mb-1">🤯</span>
            <span class="text-xs font-bold">5 分</span>
            <span class="text-[10px] text-muted">快爆炸</span>
          </button>
        </div>

        <!-- 動態同理回饋框 -->
        <div id="anxiety-feedback" class="p-4 rounded-2xl bg-ochreLight border border-ochre/30 text-sm text-ink leading-relaxed">
          💡 <strong>大腦正在保護你：</strong> 3 分的迷惘非常正常！就像走進有 500 道菜的自助餐，選擇變多反而讓人猶豫。接下來我們用遊戲幫你篩選出真正重要的菜色。
        </div>
      </div>

      <button type="button" onclick="goToStep(1)"
        class="w-full py-4 rounded-2xl bg-terracotta hover:bg-terracotta/90 text-white font-bold text-base shadow-md shadow-terracotta/20 transition flex items-center justify-center gap-2">
        <span>進入第一關：《價值觀拍賣會》</span>
        <span>→</span>
      </button>
    </section>

    <!-- ==================== STEP 1: 《價值觀拍賣會》三階段淘汰 ==================== -->
    <section id="step-1" class="hidden step-animate space-y-4">
      <!-- 關卡說明橫幅 -->
      <div class="bg-paper rounded-3xl p-5 shadow-sm border border-stone-200/70">
        <div class="flex items-center justify-between gap-2 mb-2">
          <span id="auction-badge" class="px-3 py-1 rounded-full bg-terracottaLight text-terracotta text-xs font-bold">
            第一輪：海選階段 (16 選 8)
          </span>
          <span id="auction-counter" class="text-sm font-bold text-ink bg-cream px-3 py-1 rounded-full border border-stone-200">
            已選 <span class="text-terracotta text-base">0</span> / 8 張
          </span>
        </div>
        <h2 id="auction-title" class="font-serif text-xl font-bold text-ink mb-1">
          選出你有感覺的 8 個價值觀
        </h2>
        <p id="auction-desc" class="text-xs sm:text-sm text-muted leading-relaxed">
          這 16 張牌沒有好壞之分。請直覺點擊：<strong>「如果沒有這個東西，我的人生會覺得很空虛」</strong>的 8 張牌。
        </p>

        <!-- 象限圖例（僅在第一輪顯示） -->
        <div id="category-legend" class="flex flex-wrap gap-1.5 mt-3 pt-3 border-t border-stone-100">
          <span class="text-[11px] px-2 py-0.5 rounded-md bg-ochreLight text-ochre font-medium">● 物質保障</span>
          <span class="text-[11px] px-2 py-0.5 rounded-md bg-terracottaLight text-terracotta font-medium">● 自我實現</span>
          <span class="text-[11px] px-2 py-0.5 rounded-md bg-sageLight text-sage font-medium">● 人際情感</span>
          <span class="text-[11px] px-2 py-0.5 rounded-md bg-slateBlueLight text-slateBlue font-medium">● 社會影響</span>
        </div>
      </div>

      <!-- 卡片網格容器 -->
      <div id="cards-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <!-- 由 JS 動態渲染 -->
      </div>

      <!-- 第三輪專屬：排序提示 -->
      <div id="stage3-rank-hint" class="hidden bg-sageLight/80 border border-sage/30 rounded-2xl p-3.5 text-xs text-sage font-medium flex items-center gap-2">
        <span>🏅</span>
        <span>提示：你點選的順序就是你的 <strong>TOP 1 → TOP 2 → TOP 3</strong>！若想調整順序，取消勾選再重新點擊即可。</span>
      </div>

      <!-- 底部操作按鈕列 -->
      <div class="flex gap-3 pt-2">
        <button type="button" id="btn-auction-back" onclick="handleAuctionBack()"
          class="px-5 py-3.5 rounded-2xl bg-paper border border-stone-300 text-muted font-bold text-sm hover:bg-stone-100 transition">
          ← 返回
        </button>
        <button type="button" id="btn-auction-next" onclick="handleAuctionNext()"
          class="flex-1 py-3.5 rounded-2xl bg-stone-300 text-stone-500 font-bold text-sm transition flex items-center justify-center gap-2 cursor-not-allowed">
          <span>請先選滿 8 張卡片</span>
        </button>
      </div>
    </section>

    <!-- ==================== STEP 2: 《我的羅盤中心》定義與內心誠實度 ==================== -->
    <section id="step-2" class="hidden step-animate space-y-5">
      <div class="bg-paper rounded-3xl p-5 sm:p-6 shadow-sm border border-stone-200/70">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sageLight text-sage text-xs font-bold mb-2">
          <span>羅盤校準</span> · <span>建立內在定義</span>
        </div>
        <h2 class="font-serif text-xl sm:text-2xl font-bold text-ink mb-1">
          你的三大核心價值觀
        </h2>
        <p class="text-xs sm:text-sm text-muted">
          經歷殘酷淘汰後留下的這 3 張牌，就是你做決定的底線。請用<strong>你自己的話</strong>寫下它對你的意義。
        </p>
      </div>

      <!-- Top 3 定義輸入卡片 -->
      <div id="top3-definitions-container" class="space-y-4">
        <!-- 由 JS 動態生成 -->
      </div>

      <!-- 內心誠實度檢測滑桿 -->
      <div class="bg-paper rounded-3xl p-5 sm:p-6 shadow-sm border border-stone-200/70 space-y-4">
        <div class="flex items-center gap-2">
          <span class="text-xl">🔍</span>
          <div>
            <h3 class="font-bold text-base text-ink">內心誠實度檢測</h3>
            <p class="text-xs text-muted">這 3 個選擇中，有多少是「我自己想要」，有多少是「爸媽或社會期待」？</p>
          </div>
        </div>

        <div class="pt-2">
          <div class="flex justify-between text-sm font-bold mb-2">
            <span class="text-terracotta">我自己想要：<span id="self-pct-label" class="text-lg">70</span>%</span>
            <span class="text-slateBlue">別人期待：<span id="other-pct-label" class="text-lg">30</span>%</span>
          </div>
          <input type="range" id="honesty-slider" min="0" max="100" step="5" value="70"
            oninput="updateHonestySlider(this.value)" class="w-full" />
        </div>

        <div id="honesty-feedback" class="p-3.5 rounded-2xl bg-sageLight text-sage text-xs sm:text-sm leading-relaxed">
          ✨ 很棒的平衡！你很清楚自己內心真正的渴望，同時也兼顧了現實考量。
        </div>
      </div>

      <div class="flex gap-3">
        <button type="button" onclick="goToStep(1)"
          class="px-5 py-3.5 rounded-2xl bg-paper border border-stone-300 text-muted font-bold text-sm hover:bg-stone-100 transition">
          ← 重選卡片
        </button>
        <button type="button" onclick="goToStep(3)"
          class="flex-1 py-3.5 rounded-2xl bg-terracotta hover:bg-terracotta/90 text-white font-bold text-sm shadow-md shadow-terracotta/20 transition">
          下一步：十字路口路線模擬 →
        </button>
      </div>
    </section>

    <!-- ==================== STEP 3: 《十字路口的模擬》A vs B 星級評分 ==================== -->
    <section id="step-3" class="hidden step-animate space-y-5">
      <div class="bg-paper rounded-3xl p-5 sm:p-6 shadow-sm border border-stone-200/70 space-y-4">
        <div>
          <span class="inline-block px-3 py-1 rounded-full bg-slateBlueLight text-slateBlue text-xs font-bold mb-2">
            決策天秤 · 具體比較
          </span>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-ink mb-1">
            把糾結的兩個選項放上天秤
          </h2>
          <p class="text-xs sm:text-sm text-muted">
            寫下你目前最猶豫的兩個方向（可點擊下方快速標籤填入參考）：
          </p>
        </div>

        <!-- 快速建議標籤 -->
        <div class="flex flex-wrap gap-1.5">
          <button type="button" onclick="applyRoutePreset('繼續升學讀大學', '先投入職場累積經驗')"
            class="text-xs px-2.5 py-1.5 rounded-full bg-cream hover:bg-stone-200 border border-stone-200 text-ink transition">
            💡 繼續升學 vs. 直接就業
          </button>
          <button type="button" onclick="applyRoutePreset('留在原本熟悉的科系領域', '勇敢跨界嘗試新領域')"
            class="text-xs px-2.5 py-1.5 rounded-full bg-cream hover:bg-stone-200 border border-stone-200 text-ink transition">
            💡 留在原領域 vs. 跨界嘗試
          </button>
          <button type="button" onclick="applyRoutePreset('維持現狀安穩前進', '做出一個大膽改變')"
            class="text-xs px-2.5 py-1.5 rounded-full bg-cream hover:bg-stone-200 border border-stone-200 text-ink transition">
            💡 維持現狀 vs. 做出改變
          </button>
        </div>

        <!-- 選項 A 與 B 名稱輸入 -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          <div class="p-3.5 rounded-2xl bg-terracottaLight/50 border border-terracotta/30">
            <label class="block text-xs font-bold text-terracotta mb-1">路線 A（選項一）</label>
            <input type="text" id="option-a-name" oninput="syncOptionNames()" placeholder="例：繼續升學讀大學"
              class="w-full px-3 py-2 rounded-xl bg-white border border-stone-200 text-sm font-medium focus:outline-none focus:border-terracotta" />
          </div>
          <div class="p-3.5 rounded-2xl bg-slateBlueLight/60 border border-slateBlue/30">
            <label class="block text-xs font-bold text-slateBlue mb-1">路線 B（選項二）</label>
            <input type="text" id="option-b-name" oninput="syncOptionNames()" placeholder="例：先去業界實習工作"
              class="w-full px-3 py-2 rounded-xl bg-white border border-stone-200 text-sm font-medium focus:outline-none focus:border-slateBlue" />
          </div>
        </div>
      </div>

      <!-- 星級契合度評分表 -->
      <div class="bg-paper rounded-3xl p-5 sm:p-6 shadow-sm border border-stone-200/70 space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="font-bold text-base text-ink">⭐ 價值觀契合度打分 (1~5星)</h3>
          <div class="flex items-center gap-2 text-xs font-bold">
            <span class="px-2.5 py-1 rounded-lg bg-terracottaLight text-terracotta">A: <span id="score-a-total">0</span>★</span>
            <span class="px-2.5 py-1 rounded-lg bg-slateBlueLight text-slateBlue">B: <span id="score-b-total">0</span>★</span>
          </div>
        </div>

        <div id="star-rating-rows" class="space-y-4">
          <!-- 由 JS 動態生成 Top 3 評分列 -->
        </div>
      </div>

      <!-- 直覺吸引力與最壞情況 -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- 路線 A 細節 -->
        <div class="bg-paper rounded-3xl p-5 shadow-sm border border-terracotta/30 space-y-3">
          <h4 class="font-bold text-sm text-terracotta flex items-center gap-1.5">
            <span>🅰️</span> <span class="label-opt-a">路線 A</span>
          </h4>
          <div>
            <label class="block text-xs font-medium text-muted mb-1">✨ 這條路最吸引我的地方</label>
            <textarea id="opt-a-pros" rows="2" placeholder="寫下讓你心動的理由..."
              class="w-full px-3 py-2 rounded-xl bg-cream border border-stone-200 text-sm focus:outline-none focus:border-terracotta"></textarea>
          </div>
          <div>
            <label class="block text-xs font-medium text-muted mb-1">⛈️ 我最害怕發生的「最壞情況」</label>
            <textarea id="opt-a-fear" rows="2" placeholder="你最擔心發生什麼事？"
              class="w-full px-3 py-2 rounded-xl bg-cream border border-stone-200 text-sm focus:outline-none focus:border-terracotta"></textarea>
          </div>
        </div>

        <!-- 路線 B 細節 -->
        <div class="bg-paper rounded-3xl p-5 shadow-sm border border-slateBlue/30 space-y-3">
          <h4 class="font-bold text-sm text-slateBlue flex items-center gap-1.5">
            <span>🅱️</span> <span class="label-opt-b">路線 B</span>
          </h4>
          <div>
            <label class="block text-xs font-medium text-muted mb-1">✨ 這條路最吸引我的地方</label>
            <textarea id="opt-b-pros" rows="2" placeholder="寫下讓你心動的理由..."
